[Unit]
Description=Diagnose new DIGIT-Frontend bugs read-only with Claude Code

[Service]
Type=oneshot
ExecStart=%h/digit-bug-reporter-v2/automation/auto-triage.sh
# kubectl, claude and notify-send need the login environment
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=3600
