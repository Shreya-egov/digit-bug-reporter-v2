{
  "manifest_version": 3,
  "name": "DIGIT Bug Reporter",
  "version": "0.2.0",
  "description": "Record a DIGIT HCM console tab, capture failing API calls and console errors, open a pre-filled GitHub issue for review, and track bugs through fix, PR and verification.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Report a bug"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B" }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["https://*.digit.org/*", "https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.digit.org/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.digit.org/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["github-attach.js"],
      "run_at": "document_idle"
    }
  ]
}
